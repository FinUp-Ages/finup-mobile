{
  "name": "finup-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "format": "prettier --write \"{app,src}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.0.20",
    "expo-linking": "~7.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-speech-recognition": "1.1.1",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "nativewind": "~4.1.23",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3",
    "tailwindcss": "^3.4.17",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~9.2.0",
    "prettier": "^3.4.2"
  },
  "expo": {
    "install": {
      "exclude": ["eslint-config-expo"]
    }
  }
}

# URL base da API do finup-backend.
#
# ATENCAO ao valor em desenvolvimento:
#   - emulador Android .......... http://10.0.2.2:8080
#   - simulador iOS ............. http://localhost:8080
#   - dispositivo fisico ........ http://<IP-DA-SUA-MAQUINA>:8080
# "localhost" no celular aponta para o proprio celular, nao para o seu computador.
#
# Tudo com prefixo EXPO_PUBLIC_ e embutido no binario e e PUBLICO.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# AWS Cognito (User Pool do FinUp). Nao sao segredo: o app client "FinUp" nao tem
# client secret. Veja finup-backend/contracts/auth-mobile-cognito.md.
#   - regiao ........ prefixo do COGNITO_USER_POOL_ID do back (us-east-2_... -> us-east-2)
#   - client id ..... COGNITO_CLIENT_ID do back
EXPO_PUBLIC_COGNITO_REGION=<regiao-do-pool>
EXPO_PUBLIC_COGNITO_CLIENT_ID=<client-id-do-app-client-FinUp>
